<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew-style layout. PaleoHebrewKeyboardService swaps the labels for the symbols page,
     which also shows the key_extra keys. Always left to right: a phone set to Hebrew
     would otherwise mirror every row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingHorizontal="3dp"
    android:paddingTop="4dp">

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button android:id="@+id/key_apostrophe" style="@style/KeyboardKey" android:text="'" />
        <Button android:id="@+id/key_dash" style="@style/KeyboardKey" android:text="-" />
        <Button android:id="@+id/key_qof" style="@style/KeyboardKey" android:text="𐤒" />
        <Button android:id="@+id/key_resh" style="@style/KeyboardKey" android:text="𐤓" />
        <Button android:id="@+id/key_alef" style="@style/KeyboardKey" android:text="𐤀" />
        <Button android:id="@+id/key_tet" style="@style/KeyboardKey" android:text="𐤈" />
        <Button android:id="@+id/key_waw" style="@style/KeyboardKey" android:text="𐤅" />
        <Button android:id="@+id/key_peh" style="@style/KeyboardKey" android:text="𐤐" />
        <Button android:id="@+id/key_extra1" style="@style/KeyboardKey" android:text="9" android:visibility="gone" />
        <Button android:id="@+id/key_extra2" style="@style/KeyboardKey" android:text="0" android:visibility="gone" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button android:id="@+id/key_shin" style="@style/KeyboardKey" android:text="𐤔" />
        <Button android:id="@+id/key_dalet" style="@style/KeyboardKey" android:text="𐤃" />
        <Button android:id="@+id/key_gimel" style="@style/KeyboardKey" android:text="𐤂" />
        <Button android:id="@+id/key_kaf" style="@style/KeyboardKey" android:text="𐤊" />
        <Button android:id="@+id/key_ayin" style="@style/KeyboardKey" android:text="𐤏" />
        <Button android:id="@+id/key_yod" style="@style/KeyboardKey" android:text="𐤉" />
        <Button android:id="@+id/key_het" style="@style/KeyboardKey" android:text="𐤇" />
        <Button android:id="@+id/key_lamed" style="@style/KeyboardKey" android:text="𐤋" />
        <Button android:id="@+id/key_extra3" style="@style/KeyboardKey" android:text="(" android:visibility="gone" />
        <Button android:id="@+id/key_extra4" style="@style/KeyboardKey" android:text=")" android:visibility="gone" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button android:id="@+id/key_zayin" style="@style/KeyboardKey" android:text="𐤆" />
        <Button android:id="@+id/key_sameh" style="@style/KeyboardKey" android:text="𐤎" />
        <Button android:id="@+id/key_bet" style="@style/KeyboardKey" android:text="𐤁" />
        <Button android:id="@+id/key_he" style="@style/KeyboardKey" android:text="𐤄" />
        <Button android:id="@+id/key_nun" style="@style/KeyboardKey" android:text="𐤍" />
        <Button android:id="@+id/key_mem" style="@style/KeyboardKey" android:text="𐤌" />
        <Button android:id="@+id/key_sadiq" style="@style/KeyboardKey" android:text="𐤑" />
        <Button android:id="@+id/key_taf" style="@style/KeyboardKey" android:text="𐤕" />
        <Button android:id="@+id/key_extra5" style="@style/KeyboardKey" android:text="/" android:visibility="gone" />
        <Button
            android:id="@+id/key_backspace"
            style="@style/KeyboardKey.Function"
            android:contentDescription="@string/key_delete"
            android:text="⌫" />
    </LinearLayout>

    <!-- Row 4 (space + punctuation) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_symbols"
            style="@style/KeyboardKey.Function"
            android:layout_weight="1.5"
            android:contentDescription="@string/key_symbols"
            android:text="@string/symbols_key" />
        <Button android:id="@+id/key_comma" style="@style/KeyboardKey" android:text="," />
        <Button
            android:id="@+id/key_globe"
            style="@style/KeyboardKey.Function"
            android:contentDescription="@string/key_globe"
            android:text="🌐"
            android:visibility="gone" />
        <Button
            android:id="@+id/key_space"
            style="@style/KeyboardKey"
            android:layout_weight="4"
            android:contentDescription="@string/key_word_divider"
            android:text="𐤟" />
        <Button android:id="@+id/key_dot" style="@style/KeyboardKey" android:text="." />
        <Button
            android:id="@+id/key_enter"
            style="@style/KeyboardKey.Function"
            android:layout_weight="1.5"
            android:contentDescription="@string/key_enter"
            android:text="⏎" />
    </LinearLayout>

</LinearLayout>
