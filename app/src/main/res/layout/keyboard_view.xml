<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- Row 1 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button android:id="@+id/key_apostrophe" android:text="'" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_dash" android:text="-" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_qof" android:text="𐤒" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_resh" android:text="𐤓" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_alef" android:text="𐤀" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_tet" android:text="𐤈" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_waw" android:text="𐤅" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_peh" android:text="𐤐" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button android:id="@+id/key_shin" android:text="𐤔" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_dalet" android:text="𐤃" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_gimel" android:text="𐤂" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_kaf" android:text="𐤊" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_ayin" android:text="𐤏" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_yod" android:text="𐤉" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_het" android:text="𐤇" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_lamed" android:text="𐤋" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <Button android:id="@+id/key_zayin" android:text="𐤆" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_sameh" android:text="𐤎" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_bet" android:text="𐤁" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_he" android:text="𐤄" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_nun" android:text="𐤍" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_mem" android:text="𐤌" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_sadiq" android:text="𐤑" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_taf" android:text="𐤕" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_backspace" android:text="⌫" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
    </LinearLayout>

    <!-- Row 4 (space + punctuation) -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button android:id="@+id/key_symbols" android:text="@string/symbols_key" android:layout_weight="1.5" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_comma" android:text="," android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_globe" android:text="🌐" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_space" android:text="␣" android:layout_weight="4" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_dot" android:text="." android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
        <Button android:id="@+id/key_enter" android:text="⏎" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/KeyboardKey"/>
    </LinearLayout>

</LinearLayout>
