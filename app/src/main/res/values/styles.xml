<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyboardKey" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <!-- Use 2dp padding to maximize space for the actual characters -->
        <item name="android:padding">2dp</item>

        <!-- Auto-size text is great for Phoenician characters -->
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">22sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>

        <!-- Remove default button insets to let keys be closer together -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <!-- 50dp is a sweet spot for most finger sizes without being too tall -->
        <item name="android:minHeight">50dp</item>

        <!-- Optional: Add a small margin to separate keys visually -->
        <item name="android:layout_margin">1dp</item>
    </style>
</resources>